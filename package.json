{
  "name": "ts7-monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ts7/frontend dev",
    "dev:api": "cd apps/api && wrangler pages dev",
    "build": "pnpm --filter @ts7/frontend build",
    "deploy": "pnpm build && cd apps/api && wrangler pages deploy --branch main",
    "db:migrate": "cd apps/api && wrangler d1 migrations apply jianxun",
    "test": "vitest run -c apps/api/vitest.config.ts",
    "test:watch": "vitest -c apps/api/vitest.config.ts",
    "lint": "pnpm -r run lint"
  },
  "engines": {
    "node": ">=16.20.0"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260724.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
